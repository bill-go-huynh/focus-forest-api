# Copy to .env for local development. Never commit .env.

# PostgreSQL connection string used by Prisma (CLI and runtime).
DATABASE_URL="postgresql://focus_forest:focus_forest@localhost:5432/focus_forest?schema=public"

# Database used by integration tests (`npm run test:int`). Its name must end with _test;
# the tests drop and recreate its schema.
TEST_DATABASE_URL="postgresql://focus_forest:focus_forest@localhost:5432/focus_forest_test?schema=public"

# Secret that signs access tokens: at least 32 random characters, different per
# environment. Generate one with: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Access tokens are short-lived (seconds); refresh tokens are long-lived (days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# HTTP port the API listens on.
PORT=3000

# development | test | production
NODE_ENV=development

# Early admin (CR.3). Signs admin tokens: at least 32 random characters, different from
# JWT_ACCESS_SECRET. Leave empty to keep the admin off (admin routes answer 503).
ADMIN_JWT_SECRET=
# Admin tokens are short-lived and not refreshed (seconds, at most 3600).
ADMIN_TOKEN_TTL_SECONDS=1800

# Browser origins allowed to call the API, comma separated (the admin web app).
CORS_ORIGINS=http://localhost:3001

# Push notifications (Phase 6). `none` keeps delivery off (every attempt is recorded as
# failed with PushDisabled); `expo` sends through Expo once the app has an EAS project.
PUSH_PROVIDER=none
# Optional: an Expo access token, when push security is enabled for the project.
# EXPO_ACCESS_TOKEN=
# How often the background worker runs due jobs and notifications (seconds; 0 turns it off).
JOBS_POLL_SECONDS=15

# Rate limits (Phase 7): always on outside the integration tests.
RATE_LIMITS=on
