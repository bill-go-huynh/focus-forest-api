// Prisma schema: https://pris.ly/d/prisma-schema
//
// Models are added by the implementation phase that defines them
// (docs/12_PRODUCT_IMPLEMENTATION_PLAN.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  /// Explicit, so the client is the same wherever it is generated (CR.7: the Docker build
  /// generates it before tsconfig is present, and the inferred `.ts` imports broke `node dist`).
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// One immutable version of Product configuration (docs/06_DOMAIN_MODEL.md).
/// Rows are never updated: changing a value means creating a new version.
model ProductConfigVersion {
  version   Int      @id @default(autoincrement())
  /// Key → value object, validated against the registry in src/product-config.
  values    Json
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  active       ActiveProductConfig?
  monthlyTrees MonthlyTree[]

  @@map("product_config_versions")
}

/// Singleton pointer to the active version. The migration adds CHECK (id),
/// so at most one row can exist.
model ActiveProductConfig {
  id          Boolean  @id @default(true)
  version     Int      @unique
  activatedAt DateTime @default(now()) @updatedAt @map("activated_at")

  configVersion ProductConfigVersion @relation(fields: [version], references: [version], onDelete: Restrict)

  @@map("active_product_config")
}

enum UserStatus {
  active
  suspended
  /// A5.3: removed for abuse. Like a suspension it ends every sign-in; only an admin lifts it.
  banned

  @@map("user_status")
}

/// A person using Focus Forest (docs/06_DOMAIN_MODEL.md → User).
model User {
  id           String      @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lowercased, so uniqueness ignores case.
  email        String      @unique
  /// scrypt hash with its parameters. Never the password itself.
  passwordHash String      @map("password_hash")
  status       UserStatus  @default(active)
  /// Set in onboarding. Null until then.
  displayName  String?     @map("display_name")
  /// A5.1: the unique, searchable `@username`. Lowercase `[a-z0-9_]{3,20}` (CHECK). Null until chosen.
  username     String?     @unique
  bio          String?
  /// Not writable yet: uploads arrive with object storage (docs/08 §5). Until
  /// then clients show an initials-based avatar when this is null.
  avatarUrl    String?     @map("avatar_url")
  /// IANA time zone reported by the client. Null until first reported.
  timezone     String?
  /// A5.9: the hemisphere the user chose for seasonal themes; null derives it from the time zone.
  hemisphere   Hemisphere?
  /// Also the user's join date.
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  preferences             UserPreferences?
  notificationPreferences NotificationPreference[]
  pushDevices             PushDevice[]
  focusLease              FocusLease?
  notifications           NotificationOutbox[]
  leaderboardExclusion    LeaderboardExclusion?
  topics                  Topic[]
  monthContexts           MonthAttributionContext[]
  focusSessions           FocusSession[]
  dailyGoalSettings       DailyGoalSetting[]
  weeklyGoalSettings      WeeklyGoalSetting[]
  restDays                RestDay[]
  streakRecoveries        StreakRecovery[]
  forestAreaUnlocks       ForestAreaUnlock[]
  badges                  UserBadge[]
  badgeShowcase           BadgeShowcase[]
  equipment               UserEquipment[]
  species                 UserSpecies[]
  cosmetics               UserCosmetic[]
  analyticsEvents         AnalyticsEvent[]
  following               Follow[]                  @relation("follower")
  followers               Follow[]                  @relation("followee")
  blocking                Block[]                   @relation("blocker")
  blockedBy               Block[]                   @relation("blocked")
  privacySettings         PrivacySettings?
  reactionsGiven          Reaction[]                @relation("reactor")
  reactionsReceived       Reaction[]                @relation("reactionOwner")
  reportsFiled            Report[]                  @relation("reporter")
  reportsAbout            Report[]                  @relation("reportTarget")
  warnings                UserWarning[]
  roomPlaces              RoomParticipant[]
  roomInvitesReceived     RoomInvite[]              @relation("roomInvitee")
  roomInvitesSent         RoomInvite[]              @relation("roomInviter")
  challengePlaces         ChallengeParticipant[]    @relation("challengePlace")
  challengesCreated       Challenge[]
  challengeInvitesSent    ChallengeParticipant[]    @relation("challengeInviter")
  eventParticipations     EventParticipation[]
  eventMilestoneGrants    EventMilestoneGrant[]
  communityContributions  CommunityContribution[]
  communityRewardGrants   CommunityRewardGrant[]

  @@map("users")
}

/// A long-lived refresh token, stored only as a SHA-256 hash. Tokens rotate on
/// every use; all tokens descended from one sign-in share a family.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set when the token is exchanged. Presenting it again revokes the family.
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum Theme {
  system
  light
  dark

  @@map("theme")
}

/// Display and feedback preferences (docs/06_DOMAIN_MODEL.md → User). The row
/// exists only once the user changes something; defaults live in code
/// (src/identity/preferences.defaults.ts).
model UserPreferences {
  userId         String   @id @map("user_id") @db.Uuid
  theme          Theme
  sound          Boolean
  haptics        Boolean
  /// In-app toggle. Clients also respect the system reduce-motion setting.
  reducedMotion  Boolean  @map("reduced_motion")
  /// Product analytics (CR.1): on by default for the checkpoint; off stores no event.
  shareUsageData Boolean  @default(true) @map("share_usage_data")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// The notification categories of spec §18.
enum NotificationCategory {
  dailyGoalReminder      @map("daily_goal_reminder")
  scheduledFocusReminder @map("scheduled_focus_reminder")
  streakReminder         @map("streak_reminder")
  eventStart             @map("event_start")
  eventEndingSoon        @map("event_ending_soon")
  friendInvite           @map("friend_invite")
  focusRoomInvite        @map("focus_room_invite")
  challengeUpdate        @map("challenge_update")
  badgeUnlocked          @map("badge_unlocked")
  monthlyRecapReady      @map("monthly_recap_ready")

  @@map("notification_category")
}

/// One category's setting for one user. Missing rows mean the default (off).
/// Only stores preferences: nothing is delivered until Phase 18.
model NotificationPreference {
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  enabled   Boolean
  /// Local "HH:MM" in the user's time zone. Reminder categories only.
  time      String?
  updatedAt DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// A6.3 A friend invited into a gathering room (spec §18 Focus room invite). It lets the invitee
/// see and join the room by id, private rooms included, until the room starts.
model RoomInvite {
  roomId    String   @map("room_id") @db.Uuid
  inviteeId String   @map("invitee_id") @db.Uuid
  inviterId String   @map("inviter_id") @db.Uuid
  createdAt DateTime @map("created_at")

  room    FocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invitee User      @relation("roomInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter User      @relation("roomInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@id([roomId, inviteeId])
  @@index([inviteeId])
  @@map("room_invites")
}

/// A6.5 An account kept off every leaderboard and team score (docs/09: exclude abusive accounts),
/// by staff, with a reason. Removing the row restores it.
model LeaderboardExclusion {
  userId    String   @id @map("user_id") @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  reason    String
  createdAt DateTime @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@map("leaderboard_exclusions")
}

/// A6.1 The platforms a push device can be.
enum DevicePlatform {
  ios
  android

  @@map("device_platform")
}

/// A6.1 A device that receives push notifications (docs/07: device registration). An Expo push
/// token belongs to whoever last signed in on that device.
model PushDevice {
  token        String         @id
  userId       String         @map("user_id") @db.Uuid
  platform     DevicePlatform
  appVersion   String?        @map("app_version")
  registeredAt DateTime       @map("registered_at")
  lastSeenAt   DateTime       @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

/// A6.1 The person is focusing until `endsAt` (plus a grace for pauses): no notification is
/// delivered meanwhile (docs/02). Set by the app when focus starts, cleared when it ends.
model FocusLease {
  userId    String   @id @map("user_id") @db.Uuid
  startedAt DateTime @map("started_at")
  endsAt    DateTime @map("ends_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("focus_leases")
}

/// A6.1 A background job (docs/08 §6: a Postgres-backed queue). Claimed with SKIP LOCKED, so
/// several API instances never run one twice; retried with backoff, then given up.
model Job {
  id          BigInt    @id @default(autoincrement())
  kind        String
  payload     Json
  runAt       DateTime  @map("run_at")
  /// Scheduling the same thing twice is a no-op.
  dedupeKey   String?   @unique @map("dedupe_key")
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  lastError   String?   @map("last_error")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([runAt])
  @@map("jobs")
}

/// A6.1 Where a notification stands.
enum NotificationStatus {
  pending
  sent
  skipped
  failed

  @@map("notification_status")
}

/// A6.1 Every notification, whatever produced it, and what became of it (sent, or skipped with
/// the reason). Rows are kept, so support can see why something was not sent.
model NotificationOutbox {
  id           BigInt               @id @default(autoincrement())
  userId       String               @map("user_id") @db.Uuid
  category     NotificationCategory
  /// One notification per user and key (an event's start, a day's reminder).
  dedupeKey    String               @map("dedupe_key")
  /// What it is about (an event id, a room id), for the relevance check.
  subject      String?
  title        String
  body         String
  /// An app path (`notification-links.ts`).
  link         String
  /// A reminder the person set: kept at its time, not counted against the daily limit.
  requested    Boolean
  notBefore    DateTime             @map("not_before")
  expiresAt    DateTime             @map("expires_at")
  createdAt    DateTime             @map("created_at")
  status       NotificationStatus   @default(pending)
  /// Held back by focus: due again as soon as the focus lease is cleared.
  heldForFocus Boolean              @default(false) @map("held_for_focus")
  reason       String?
  sentAt       DateTime?            @map("sent_at")
  lockedUntil  DateTime?            @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([status, notBefore])
  @@index([userId, status, sentAt])
  @@map("notification_outbox")
}

enum TopicStatus {
  active
  archived

  @@map("topic_status")
}

/// A user-defined label for what the user focuses on (docs/06_DOMAIN_MODEL.md → Topic).
/// There is no hard delete: archiving hides a topic from pickers and keeps its history.
///
/// Raw SQL in the migration adds what Prisma cannot express:
/// - a partial unique index: active names are unique per user, ignoring case
///   (lower() under the ICU root collation, so it does not depend on the database locale);
/// - a CHECK that archived_at is set exactly when the topic is archived.
model Topic {
  /// Generated by the client, so a topic created offline keeps its id when it syncs.
  /// Scoped to the user by the composite key, so ids never collide across users.
  id                String      @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  /// Trimmed, Unicode NFC.
  name              String
  /// A content identifier. The client decides how it renders.
  icon              String
  /// One of topic.1 … topic.12.
  color             String
  description       String?
  status            TopicStatus @default(active)
  archivedAt        DateTime?   @map("archived_at")
  /// SHA-256 of the payload the topic was created with. A PUT with the same id is a replay
  /// only when its payload matches this, whatever edits happened since.
  createFingerprint String      @map("create_fingerprint")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]

  @@id([userId, id])
  @@index([userId, createdAt])
  @@map("topics")
}

/// One month of a user's timeline for attributing sessions (docs/06_DOMAIN_MODEL.md → Time
/// and attribution): the time zone frozen when the month's first session arrived, and the
/// month's UTC interval [starts_at, ends_at). Adjacent months share their boundary, so every
/// instant belongs to at most one context. Rows are never updated.
///
/// Not a monthly tree: it holds only what attribution needs.
///
/// Raw SQL in the migration adds CHECKs: month is 1–12 and starts_at < ends_at.
model MonthAttributionContext {
  userId    String    @map("user_id") @db.Uuid
  year      Int
  month     Int
  /// IANA name, from the profile when the context was created.
  timezone  String
  startsAt  DateTime  @map("starts_at")
  endsAt    DateTime  @map("ends_at")
  /// When the month was closed (archived or left resting), after endsAt plus the grace period.
  /// Sessions attributed to a closed month never grow a tree.
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]
  tree          MonthlyTree?

  @@id([userId, year, month])
  @@index([userId, startsAt])
  @@map("month_attribution_contexts")
}

enum FocusSessionStatus {
  completed
  ended_early
  discarded

  @@map("focus_session_status")
}

/// One period of focus, the central fact of the product (docs/06_DOMAIN_MODEL.md →
/// FocusSession). The client submits the raw times; the server derives the rest once, with
/// one configuration version, and never changes it apart from the note.
///
/// The raw fields are immutable, so a replay is recognised by comparing them: there is no
/// stored fingerprint. `counted` is not stored either: it is exactly `status != discarded`.
///
/// Raw SQL in the migration adds CHECKs on the derived values.
model FocusSession {
  /// Generated by the client, so retries are idempotent. Scoped to the user.
  id                  String             @db.Uuid
  userId              String             @map("user_id") @db.Uuid
  topicId             String             @map("topic_id") @db.Uuid
  startedAt           DateTime           @map("started_at")
  /// The end the client submitted. The session may have ended earlier (effectiveEndedAt).
  submittedEndedAt    DateTime           @map("submitted_ended_at")
  plannedMinutes      Int                @map("planned_minutes")
  /// The submitted pauses, [{ "startedAt": ISO, "endedAt": ISO }], half-open, chronological.
  pauseIntervals      Json               @map("pause_intervals")
  effectiveEndedAt    DateTime           @map("effective_ended_at")
  focusedMilliseconds Int                @map("focused_milliseconds")
  pausedMilliseconds  Int                @map("paused_milliseconds")
  status              FocusSessionStatus
  /// Real local date of the start in the month context's time zone.
  localDate           DateTime           @map("local_date") @db.Date
  year                Int
  month               Int
  /// The Product configuration version the derived values were computed with.
  configVersion       Int                @map("config_version")
  /// Personal data: keep out of logs. Written by the note endpoint only.
  note                String?
  /// Chosen by the user for the month's Tree Details and recap. Only with a note.
  noteHighlighted     Boolean            @default(false) @map("note_highlighted")
  /// What this session did to its month's tree (GrowthResultDto), written once in the same
  /// transaction as the session and returned unchanged on every replay. Null for sessions
  /// stored before Phase 3.
  growthResult        Json?              @map("growth_result")
  /// The badges this session caused (A4.2), stored with it and replayed unchanged; null before.
  progressionResult   Json?              @map("progression_result")
  /// A5.6: the joined events' mission progress this session caused. Null before A5.6.
  eventResult         Json?              @map("event_result")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction (checked at the end of the statement), so deleting a user still cascades.
  topic        Topic                   @relation(fields: [userId, topicId], references: [userId, id], onDelete: NoAction)
  monthContext MonthAttributionContext @relation(fields: [userId, year, month], references: [userId, year, month], onDelete: NoAction)
  roomPlaces   RoomParticipant[]

  @@id([userId, id])
  @@index([userId, startedAt])
  /// The latest session of a topic: recent topics and the remembered duration.
  @@index([userId, topicId, startedAt, id])
  @@index([userId, year, month])
  @@map("focus_sessions")
}

/// One version of the daily goal (docs/06_DOMAIN_MODEL.md → DailyGoal), in effect from its local
/// date until the next version. Before the first version the configured default applies.
/// Versions in effect are never changed; only a pending (future) version is replaced.
model DailyGoalSetting {
  userId        String   @map("user_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  minutes       Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, effectiveFrom])
  @@map("daily_goal_settings")
}

enum WeeklyGoalType {
  focused_minutes
  session_count

  @@map("weekly_goal_type")
}

/// One version of the weekly goal (docs/06_DOMAIN_MODEL.md → WeeklyGoal), in effect from its
/// Monday until the next version. Weeks run Monday to Sunday. A version without type and target
/// records that the user cleared the weekly goal from that week on.
model WeeklyGoalSetting {
  userId        String          @map("user_id") @db.Uuid
  /// Always a Monday (checked by the database).
  effectiveFrom DateTime        @map("effective_from") @db.Date
  type          WeeklyGoalType?
  target        Int?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, effectiveFrom])
  @@map("weekly_goal_settings")
}

/// A planned rest day (docs/06_DOMAIN_MODEL.md → RestDay), on the user's local date. Cancelling
/// (possible until the day ends) deletes the row, so every row is a rest day that happened or
/// is still planned.
model RestDay {
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("rest_days")
}

enum StreakRecoveryMechanic {
  next_day_session

  @@map("streak_recovery_mechanic")
}

/// A missed day repaired by a streak recovery (docs/06_DOMAIN_MODEL.md → StreakRecovery). It
/// bridges the streak only: never an active day, a goal day, growth, or vitality.
model StreakRecovery {
  userId            String                 @map("user_id") @db.Uuid
  missedDate        DateTime               @map("missed_date") @db.Date
  /// The day of the counted session that earned it: the day after the missed day.
  returnDate        DateTime               @map("return_date") @db.Date
  mechanic          StreakRecoveryMechanic
  /// The badges this recovery caused (A4.2.G), stored with it and answered unchanged on a
  /// repeated acceptance; null before.
  progressionResult Json?                  @map("progression_result")
  createdAt         DateTime               @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, missedDate])
  @@map("streak_recoveries")
}

enum MonthlyTreeStatus {
  growing
  archived

  @@map("monthly_tree_status")
}

enum TreeStage {
  seed
  sprout
  young_tree
  growing_tree
  mature_tree
  blooming_tree
  final_form

  @@map("tree_stage")
}

/// The one tree of one user's month (docs/06_DOMAIN_MODEL.md → MonthlyTree, TreeProgress).
/// Its identity is its month attribution context, so the two can never disagree. It stores only
/// what was earned (the permanent maxima) and what keeps it reproducible; growth amounts and
/// vitality are derived from sessions. Earned state changes only when a session is submitted.
model MonthlyTree {
  userId               String            @map("user_id") @db.Uuid
  year                 Int
  month                Int
  status               MonthlyTreeStatus @default(growing)
  /// A TreeSpecies id ("signature" until species choice, A4.3). Fixed once archived.
  species              String
  /// Unsigned 32-bit (src/trees/variation-seed.ts).
  variationSeed        BigInt            @map("variation_seed")
  /// The configuration version this month's structural progression uses, fixed at creation.
  configVersion        Int               @map("config_version")
  /// The user's join date in the month's time zone, and the first-month factor it gave.
  joinedOn             DateTime          @map("joined_on") @db.Date
  prorationNumerator   Int               @map("proration_numerator")
  prorationDenominator Int               @map("proration_denominator")
  stage                TreeStage         @default(seed)
  fullnessLevel        Int               @default(0) @map("fullness_level")
  blossomLevel         Int               @default(0) @map("blossom_level")
  richnessTier         Int               @default(0) @map("richness_tier")
  archivedAt           DateTime?         @map("archived_at")
  /// The immutable snapshot taken at archive (TreeArchive): progress, traits, time zone, and the
  /// month's stats. Null while growing. An archived row is never updated.
  archive              Json?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  monthContext      MonthAttributionContext @relation(fields: [userId, year, month], references: [userId, year, month], onDelete: Cascade)
  config            ProductConfigVersion    @relation(fields: [configVersion], references: [version], onDelete: Restrict)
  speciesDefinition TreeSpecies             @relation(fields: [species], references: [id], onDelete: Restrict, onUpdate: Restrict)
  traits            MonthlyTreeTrait[]
  recap             MonthlyRecap?

  @@id([userId, year, month])
  @@map("monthly_trees")
}

/// A milestone trait earned on one month's tree, by stable identifier. Never removed.
model MonthlyTreeTrait {
  userId    String   @map("user_id") @db.Uuid
  year      Int
  month     Int
  traitId   String   @map("trait_id")
  earnedAt  DateTime @map("earned_at")
  /// The session whose submission earned it.
  sessionId String?  @map("session_id") @db.Uuid

  tree MonthlyTree @relation(fields: [userId, year, month], references: [userId, year, month], onDelete: Cascade)

  @@id([userId, year, month, traitId])
  @@map("monthly_tree_traits")
}

/// The story of one archived month (docs/06_DOMAIN_MODEL.md → MonthlyRecap), generated once in
/// the archive transaction. Its content never changes; only the seen times are set, once each.
model MonthlyRecap {
  userId         String    @map("user_id") @db.Uuid
  year           Int
  month          Int
  /// RecapContent. Holds no note text: highlighted notes are referenced by session id.
  content        Json
  createdAt      DateTime  @map("created_at")
  /// When the month-end ceremony was first shown.
  ceremonySeenAt DateTime? @map("ceremony_seen_at")
  /// When the recap was first viewed.
  recapSeenAt    DateTime? @map("recap_seen_at")

  tree MonthlyTree @relation(fields: [userId, year, month], references: [userId, year, month], onDelete: Cascade)

  @@id([userId, year, month])
  @@map("monthly_recaps")
}

/// A cosmetic forest area the user has unlocked (docs/06_DOMAIN_MODEL.md → ForestProgression).
/// Unlocks only accumulate: a later configuration with higher thresholds never removes one.
model ForestAreaUnlock {
  userId     String   @map("user_id") @db.Uuid
  /// A stable area identifier such as "lake".
  areaId     String   @map("area_id")
  unlockedAt DateTime @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, areaId])
  @@map("forest_area_unlocks")
}

// ── Progression (Phase 4 / legacy 8–10, A4.1) ──────────────────────────────────────────────
// Content definitions are versioned seed data (migrations) until the admin product (Phase 19).
// Identifiers are immutable lowercase slugs (src/progression/progression-rules.ts), unique per
// content type. Ownership rows are permanent; availability decides acquisition, never ownership.
// Nothing here changes focus, growth, goals, streaks, or recovery.

enum ContentStatus {
  /// Defined, not acquirable yet (for example Social badges before Phase 11).
  planned
  active
  /// No longer acquirable; owners keep it.
  retired

  @@map("content_status")
}

enum ContentSource {
  /// Owned by every user (the signature species).
  system
  achievement
  /// Phase 14.
  event
  /// Phase 17.
  season

  @@map("content_source")
}

enum ContentAvailability {
  permanent
  limited

  @@map("content_availability")
}

enum ContentRarity {
  common
  rare
  legendary

  @@map("content_rarity")
}

enum BadgeCategory {
  focus
  consistency
  time_based
  social
  event
  rare

  @@map("badge_category")
}

enum CosmeticType {
  background
  decoration
  fauna
  weather
  profile_frame
  effect

  @@map("cosmetic_type")
}

enum AchievementCriterion {
  counted_sessions
  focused_minutes
  longest_streak_days
  /// A5.4: completed Focus Together sessions.
  focus_together_sessions
  /// A5.4: completed Focus Together sessions in a room where a friend (a mutual follow) focused too.
  focus_together_with_friend

  @@map("achievement_criterion")
}

/// A badge (docs/06 → Badge). Artwork lives in the app, by `artworkId`.
model BadgeDefinition {
  id             String              @id
  category       BadgeCategory
  rarity         ContentRarity
  source         ContentSource
  availability   ContentAvailability
  status         ContentStatus
  availableFrom  DateTime?           @map("available_from")
  /// Exclusive. Set exactly when availability is limited.
  availableUntil DateTime?           @map("available_until")
  name           String
  description    String
  artworkId      String              @map("artwork_id")
  sortOrder      Int                 @default(0) @map("sort_order")
  createdAt      DateTime            @default(now()) @map("created_at")

  achievement         AchievementDefinition?
  owners              UserBadge[]
  milestones          EventMilestone[]
  communityMilestones CommunityMilestone[]
  seasonalRewards     SeasonalReward[]

  @@map("badge_definitions")
}

/// A long-term achievement and the one badge it grants. Its category, name, and availability are
/// the badge's; progress is derived from Phase 3 truth (A4.2), never stored.
model AchievementDefinition {
  id              String               @id
  badgeId         String               @unique @map("badge_id")
  criterion       AchievementCriterion
  /// In the criterion's unit: sessions, minutes, or days.
  target          Int
  progressVisible Boolean              @default(true) @map("progress_visible")
  createdAt       DateTime             @default(now()) @map("created_at")

  badge     BadgeDefinition      @relation(fields: [badgeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  species   TreeSpecies[]
  cosmetics CosmeticDefinition[]

  @@map("achievement_definitions")
}

/// A tree species or rare variant (docs/06 → TreeSpecies). Every species shares the tree's one
/// progression framework: no growth rules here. Visuals live in the app, by `id`.
model TreeSpecies {
  id             String              @id
  /// For a rare variant: the species it varies.
  baseSpeciesId  String?             @map("base_species_id")
  rarity         ContentRarity
  source         ContentSource
  /// Set exactly when the source is an achievement.
  achievementId  String?             @map("achievement_id")
  availability   ContentAvailability
  status         ContentStatus
  availableFrom  DateTime?           @map("available_from")
  availableUntil DateTime?           @map("available_until")
  name           String
  description    String
  sortOrder      Int                 @default(0) @map("sort_order")
  createdAt      DateTime            @default(now()) @map("created_at")

  baseSpecies TreeSpecies?           @relation("SpeciesVariants", fields: [baseSpeciesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variants    TreeSpecies[]          @relation("SpeciesVariants")
  achievement AchievementDefinition? @relation(fields: [achievementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owners      UserSpecies[]
  trees       MonthlyTree[]

  @@map("tree_species")
}

/// A garden, profile, or scene cosmetic (docs/06 → Cosmetic). Never affects growth or focus.
model CosmeticDefinition {
  id             String              @id
  type           CosmeticType
  rarity         ContentRarity
  source         ContentSource
  achievementId  String?             @map("achievement_id")
  availability   ContentAvailability
  status         ContentStatus
  availableFrom  DateTime?           @map("available_from")
  availableUntil DateTime?           @map("available_until")
  name           String
  description    String
  artworkId      String              @map("artwork_id")
  sortOrder      Int                 @default(0) @map("sort_order")
  createdAt      DateTime            @default(now()) @map("created_at")

  achievement         AchievementDefinition? @relation(fields: [achievementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owners              UserCosmetic[]
  equipped            UserEquipment[]
  milestones          EventMilestone[]
  communityMilestones CommunityMilestone[]
  seasonalRewards     SeasonalReward[]

  @@unique([id, type])
  @@map("cosmetic_definitions")
}

/// A badge the user earned. Permanent: never changed, removed only with the user.
model UserBadge {
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id")
  earnedAt DateTime @map("earned_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  showcase BadgeShowcase?

  @@id([userId, badgeId])
  @@map("user_badges")
}

/// What the user shows (A4.3): one owned cosmetic per slot, the slot being the cosmetic's
/// type (the profile frame belongs to the profile only). Ownership is checked by a trigger.
model UserEquipment {
  userId     String       @map("user_id") @db.Uuid
  slot       CosmeticType
  cosmeticId String       @map("cosmetic_id")
  equippedAt DateTime     @default(now()) @map("equipped_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic CosmeticDefinition @relation(fields: [cosmeticId, slot], references: [id, type], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, slot])
  @@map("user_equipment")
}

/// The user's ordered badge showcase (A4.2): at most three owned badges, positions 1 to 3.
/// Replaced as a whole. Only an owned badge can be pinned (the ownership foreign key).
model BadgeShowcase {
  userId   String @map("user_id") @db.Uuid
  badgeId  String @map("badge_id")
  position Int

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownership UserBadge @relation(fields: [userId, badgeId], references: [userId, badgeId], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, badgeId])
  @@unique([userId, position])
  @@map("badge_showcase")
}

/// A species the user unlocked (system species are owned by everyone without a row). Permanent.
model UserSpecies {
  userId     String   @map("user_id") @db.Uuid
  speciesId  String   @map("species_id")
  unlockedAt DateTime @map("unlocked_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  species TreeSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, speciesId])
  @@map("user_species")
}

/// A cosmetic the user unlocked. Permanent.
model UserCosmetic {
  userId     String   @map("user_id") @db.Uuid
  cosmeticId String   @map("cosmetic_id")
  unlockedAt DateTime @map("unlocked_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic CosmeticDefinition @relation(fields: [cosmeticId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, cosmeticId])
  @@map("user_cosmetics")
}

/// A product analytics event (CR.1; docs/08 §6). Operational data for the Core Loop Checkpoint,
/// never product truth: no product feature reads it. The id is the client's, so a retried batch
/// stores each event once. The name is CHECKed against a closed allowlist; props hold only
/// allowlisted integers. Deleted with the user.
model AnalyticsEvent {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  name       String
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @map("received_at")
  localDate  DateTime @map("local_date") @db.Date
  platform   String
  appVersion String   @map("app_version")
  props      Json     @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@index([name, occurredAt])
  @@map("analytics_events")
}

/// Early admin roles (docs/09; CR.3). `moderator` and `content` arrive with their phases.
/// Who can see one category of a user's content (spec §19.1). Friends = mutual follows.
enum PrivacyLevel {
  public
  friends
  private

  @@map("privacy_level")
}

/// A5.1: one user following another. No approval step; a mutual follow is a friendship.
/// A trigger refuses a follow while either user blocks the other.
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @map("created_at")

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followerId, createdAt])
  @@index([followeeId, createdAt])
  @@map("follows")
}

/// A5.1: a block overrides everything, in both directions (spec §19.2).
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @map("created_at")

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId, createdAt])
  @@map("blocks")
}

/// A5.1: per-category visibility. No row means the defaults in `src/social/visibility.ts`;
/// the first change writes every category, so the database holds no second set of defaults.
model PrivacySettings {
  userId       String       @id @map("user_id") @db.Uuid
  profile      PrivacyLevel
  forest       PrivacyLevel
  statistics   PrivacyLevel
  badges       PrivacyLevel
  currentTree  PrivacyLevel @map("current_tree")
  /// A5.8: whether the user appears on leaderboards. Opt-in: off by default (docs/02).
  leaderboards Boolean      @default(false)
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

/// What a reaction is on (spec §13.3–13.4): a whole forest, one month's tree, or an owned badge.
enum ReactionTargetType {
  forest
  tree
  badge

  @@map("reaction_target_type")
}

/// The five spec §13.4 reactions, as stable ids. The app draws them (🔥 🌱 👏 ❤️ ✨).
enum ReactionKind {
  fire
  sprout
  clap
  heart
  sparkles

  @@map("reaction_kind")
}

/// A5.2: one user's reaction to another's content. No text. Each kind at most once per target
/// and reactor. A block removes reactions both ways, and a trigger refuses one next to a block.
model Reaction {
  id         String             @id @default(uuid(7)) @db.Uuid
  reactorId  String             @map("reactor_id") @db.Uuid
  ownerId    String             @map("owner_id") @db.Uuid
  targetType ReactionTargetType @map("target_type")
  /// '' for a forest, 'YYYY-MM' for a tree, the badge id for a badge (CHECK).
  targetKey  String             @map("target_key")
  reaction   ReactionKind
  createdAt  DateTime           @map("created_at")

  reactor User @relation("reactor", fields: [reactorId], references: [id], onDelete: Cascade)
  owner   User @relation("reactionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([reactorId, ownerId, targetType, targetKey, reaction])
  @@index([ownerId, targetType, targetKey])
  @@index([ownerId, createdAt])
  @@map("reactions")
}

/// What a report is about (spec §19.3).
enum ReportCategory {
  account
  username
  avatar
  bio
  behavior

  @@map("report_category")
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed

  @@map("report_status")
}

/// What a moderator did when resolving a report (docs/09 Reports and moderation).
enum ModerationAction {
  none
  warn
  reset_username
  reset_bio
  reset_avatar
  suspend
  ban

  @@map("moderation_action")
}

/// A5.3: a user's report about another user. Survives the reporter's deletion (the reporter
/// becomes null) and goes with the reported user. One unfinished report per reporter, user, and
/// category (a partial unique index). CHECKs keep the resolution consistent with the status.
model Report {
  id               String            @id @default(uuid(7)) @db.Uuid
  reporterId       String?           @map("reporter_id") @db.Uuid
  targetId         String            @map("target_id") @db.Uuid
  category         ReportCategory
  /// Optional, at most 500 characters, written by the reporter for the moderators.
  details          String?
  status           ReportStatus      @default(open)
  createdAt        DateTime          @map("created_at")
  reviewedById     String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at")
  resolvedById     String?           @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?         @map("resolved_at")
  /// Set when resolved, null when dismissed.
  action           ModerationAction?
  resolutionReason String?           @map("resolution_reason")

  reporter   User?         @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  target     User          @relation("reportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser?    @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedBy AdminUser?    @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  warnings   UserWarning[]

  @@index([status, createdAt])
  @@index([targetId])
  @@index([reporterId])
  @@map("reports")
}

/// A5.3: a moderator's warning to a user, with a message the user reads in the app.
model UserWarning {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  reportId       String?   @map("report_id") @db.Uuid
  message        String
  createdAt      DateTime  @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("user_warnings")
}

enum RoomVisibility {
  public
  private

  @@map("room_visibility")
}

/// Stored room status. Countdown, focusing, and ended are derived from the start time and the
/// clock (`src/rooms/room-rules.ts`).
enum RoomStatus {
  lobby
  in_session
  closed

  @@map("room_status")
}

/// A5.4 Focus Together (docs/06 FocusRoom, spec §14): a shared space to focus at the same time.
/// The room grows no tree: each participant's focus is their own FocusSession. The host is not
/// stored: it is the present participant who joined first.
model FocusRoom {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// Six characters without lookalikes, to share (CHECK).
  code            String         @unique
  name            String
  topic           String?
  durationMinutes Int            @map("duration_minutes")
  maxParticipants Int            @map("max_participants")
  visibility      RoomVisibility
  status          RoomStatus     @default(lobby)
  createdAt       DateTime       @map("created_at")
  /// The server-decided synchronized start (docs/07 §6).
  startsAt        DateTime?      @map("starts_at")
  closedAt        DateTime?      @map("closed_at")

  participants RoomParticipant[]
  invites      RoomInvite[]

  @@index([status, visibility, createdAt])
  @@map("focus_rooms")
}

/// One person's place in a room. `leftAt` set means they left (quietly: nobody else is told).
/// `inSession` marks who started with the room; `sessionId` links their own completed session.
model RoomParticipant {
  roomId      String    @map("room_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  joinedAt    DateTime  @map("joined_at")
  readyAt     DateTime? @map("ready_at")
  leftAt      DateTime? @map("left_at")
  inSession   Boolean   @default(false) @map("in_session")
  sessionId   String?   @map("session_id") @db.Uuid
  completedAt DateTime? @map("completed_at")

  room    FocusRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The session must be the participant's own.
  session FocusSession? @relation(fields: [userId, sessionId], references: [userId, id], onDelete: NoAction)

  @@id([roomId, userId])
  @@unique([userId, sessionId])
  @@index([userId, leftAt])
  @@map("room_participants")
}

enum ChallengeKind {
  personal
  friend
  group

  @@map("challenge_kind")
}

enum ChallengeMeasure {
  focus_minutes
  sessions
  active_days

  @@map("challenge_measure")
}

enum ChallengeGoal {
  each
  shared

  @@map("challenge_goal")
}

enum ChallengePlaceStatus {
  invited
  joined

  @@map("challenge_place_status")
}

/// A5.5 (docs/06 Challenge, spec §15): a template's terms copied at creation, so a configuration
/// change never alters it, and a window of local dates. Progress is derived from participants'
/// counted sessions; `completedAt` is stored the first time the goal is seen reached, then kept.
model Challenge {
  id              String           @id @default(uuid(7)) @db.Uuid
  templateId      String           @map("template_id")
  kind            ChallengeKind
  measure         ChallengeMeasure
  goal            ChallengeGoal
  target          Int
  dailyMinutes    Int              @map("daily_minutes")
  days            Int
  maxParticipants Int              @map("max_participants")
  configVersion   Int              @map("config_version")
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime         @map("end_date") @db.Date
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @map("created_at")
  completedAt     DateTime?        @map("completed_at")

  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  participants ChallengeParticipant[]

  @@map("challenges")
}

/// One person in a challenge: invited, then joined. Declining or leaving deletes the row: no trace,
/// no penalty (docs/02).
model ChallengeParticipant {
  challengeId String               @map("challenge_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  status      ChallengePlaceStatus
  invitedById String?              @map("invited_by_id") @db.Uuid
  createdAt   DateTime             @map("created_at")
  joinedAt    DateTime?            @map("joined_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation("challengePlace", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("challengeInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@id([challengeId, userId])
  @@index([userId, status])
  @@map("challenge_participants")
}

enum EventMissionMeasure {
  focus_minutes
  sessions
  active_days
  streak_days
  focus_together_sessions

  @@map("event_mission_measure")
}

/// A5.6 (docs/06 Event, spec §11): a time-bound program, as content (seed data until the admin
/// content tools). Planned events are not shown; retired ones stay readable for those who joined.
model Event {
  id               String        @id
  name             String
  description      String
  artworkId        String        @map("artwork_id")
  status           ContentStatus
  /// The window: missions count counted sessions that started in [startsAt, endsAt).
  startsAt         DateTime      @map("starts_at")
  endsAt           DateTime      @map("ends_at")
  /// Entry condition: counted sessions before joining (0 = open to everyone).
  entryMinSessions Int           @default(0) @map("entry_min_sessions")
  sortOrder        Int           @default(0) @map("sort_order")
  /// A5.8: whether the event has its own leaderboard (docs/06 Event: optional).
  leaderboard      Boolean       @default(false)

  missions       EventMission[]
  milestones     EventMilestone[]
  participations EventParticipation[]
  grants         EventMilestoneGrant[]
  communityTree  CommunityTree?
  teams          EventTeam[]

  @@map("events")
}

/// A goal within an event (docs/06 EventMission), derived from the user's normal sessions.
model EventMission {
  eventId      String              @map("event_id")
  id           String
  measure      EventMissionMeasure
  target       Int
  /// For active days: the counted minutes a day needs (0 = any counted session).
  dailyMinutes Int                 @default(0) @map("daily_minutes")
  name         String
  description  String
  sortOrder    Int                 @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, id])
  @@map("event_missions")
}

/// Reached when enough missions are completed; grants its rewards once, owned forever.
model EventMilestone {
  eventId          String  @map("event_id")
  id               String
  requiredMissions Int     @map("required_missions")
  badgeId          String? @map("badge_id")
  cosmeticId       String? @map("cosmetic_id")
  /// An event trait on the tree growing when it is reached (`event:<event id>`).
  traitId          String? @map("trait_id")
  name             String
  sortOrder        Int     @default(0) @map("sort_order")

  event    Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badge    BadgeDefinition?      @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  cosmetic CosmeticDefinition?   @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)
  grants   EventMilestoneGrant[]

  @@id([eventId, id])
  @@map("event_milestones")
}

/// The user's choice to join (docs/02: events are invitations).
model EventParticipation {
  userId   String   @map("user_id") @db.Uuid
  eventId  String   @map("event_id")
  joinedAt DateTime @map("joined_at")
  /// A5.8: the participant's team, on events with teams (the smallest team on joining).
  teamId   String?  @map("team_id")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team  EventTeam? @relation(fields: [eventId, teamId], references: [eventId, id], onDelete: Restrict)

  @@id([userId, eventId])
  @@map("event_participations")
}

/// A milestone reached by a participant: its rewards are granted once. The trait's tree is where
/// it was placed (null until a growing tree exists to receive it).
model EventMilestoneGrant {
  userId      String   @map("user_id") @db.Uuid
  eventId     String   @map("event_id")
  milestoneId String   @map("milestone_id")
  reachedAt   DateTime @map("reached_at")
  traitYear   Int?     @map("trait_year")
  traitMonth  Int?     @map("trait_month")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  milestone EventMilestone @relation(fields: [eventId, milestoneId], references: [eventId, id], onDelete: Restrict)

  @@id([userId, eventId, milestoneId])
  @@map("event_milestone_grants")
}

/// A5.8 A team of an event, for team ranking (spec §16.3). Content, like the event.
model EventTeam {
  eventId   String @map("event_id")
  id        String
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participations EventParticipation[]

  @@id([eventId, id])
  @@map("event_teams")
}

/// A5.9 Hemispheres for seasonal themes (docs/03 §10).
enum Hemisphere {
  north
  south

  @@map("hemisphere")
}

/// A5.9 A seasonal theme (spec §17.1, docs/06 SeasonalTheme): content for one hemisphere (or both)
/// and a window. It changes environment and atmosphere layers, never a tree's earned structure.
model SeasonalTheme {
  id            String        @id
  name          String
  description   String
  /// The art set of the environment and atmosphere layers.
  environmentId String        @map("environment_id")
  /// Null: both hemispheres.
  hemisphere    Hemisphere?
  status        ContentStatus
  startsAt      DateTime      @map("starts_at")
  endsAt        DateTime      @map("ends_at")
  sortOrder     Int           @default(0) @map("sort_order")

  rewards SeasonalReward[]

  @@map("seasonal_themes")
}

/// A5.9 A theme's limited collection (spec §17.3): one badge or cosmetic, earned with this many
/// active days in the theme's window, owned forever.
model SeasonalReward {
  themeId            String  @map("theme_id")
  id                 String
  badgeId            String? @map("badge_id")
  cosmeticId         String? @map("cosmetic_id")
  requiredActiveDays Int     @map("required_active_days")
  sortOrder          Int     @default(0) @map("sort_order")

  theme    SeasonalTheme       @relation(fields: [themeId], references: [id], onDelete: Cascade)
  badge    BadgeDefinition?    @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  cosmetic CosmeticDefinition? @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)

  @@id([themeId, id])
  @@map("seasonal_rewards")
}

/// A5.7 Community Tree stages (spec §12), in growing order.
enum CommunityStage {
  seedling
  growing_tree
  bloom
  final_form

  @@map("community_stage")
}

/// A5.7 The shared tree of an event (spec §12, docs/06 CommunityTree). It grows from the total
/// focus minutes of the event's participants and never loses progress: a trigger refuses a lower
/// total. The row is the one lock every contribution takes.
model CommunityTree {
  eventId      String @id @map("event_id")
  name         String
  artworkId    String @map("artwork_id")
  /// The sum of the contribution ledger, kept with it in one transaction.
  totalMinutes BigInt @default(0) @map("total_minutes")

  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  milestones    CommunityMilestone[]
  contributions CommunityContribution[]

  @@map("community_trees")
}

/// A community milestone and its shared reward. `reachedAt` is set once and never changes.
model CommunityMilestone {
  eventId          String         @map("event_id")
  stage            CommunityStage
  thresholdMinutes BigInt         @map("threshold_minutes")
  badgeId          String?        @map("badge_id")
  cosmeticId       String?        @map("cosmetic_id")
  reachedAt        DateTime?      @map("reached_at")

  tree     CommunityTree          @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  badge    BadgeDefinition?       @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  cosmetic CosmeticDefinition?    @relation(fields: [cosmeticId], references: [id], onDelete: Restrict)
  grants   CommunityRewardGrant[]

  @@id([eventId, stage])
  @@map("community_milestones")
}

/// The append-only contribution ledger: one row per counted session of a participant that started
/// in the window. Deleting the account keeps the minutes anonymously (`userId` becomes null).
model CommunityContribution {
  id            BigInt   @id @default(autoincrement())
  eventId       String   @map("event_id")
  userId        String?  @map("user_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  minutes       Int
  contributedAt DateTime @map("contributed_at")

  tree CommunityTree @relation(fields: [eventId], references: [eventId], onDelete: Restrict)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, sessionId])
  @@map("community_contributions")
}

/// A participant's share of a reached milestone: granted once, celebrated once (docs/04).
model CommunityRewardGrant {
  userId       String         @map("user_id") @db.Uuid
  eventId      String         @map("event_id")
  stage        CommunityStage
  grantedAt    DateTime       @map("granted_at")
  celebratedAt DateTime?      @map("celebrated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone CommunityMilestone @relation(fields: [eventId, stage], references: [eventId, stage], onDelete: Restrict)

  @@id([userId, eventId, stage])
  @@map("community_reward_grants")
}

enum AdminRole {
  admin
  support
  /// A5.3: reports and moderation (docs/09).
  moderator
  /// A6.4: content definitions and live content (docs/09), and only those.
  content

  @@map("admin_role")
}

enum AdminStatus {
  active
  disabled

  @@map("admin_status")
}

/// An admin of the internal tool (CR.3): not an app user, with its own credentials and tokens.
/// Created by `npm run admin:create`; there is no creation endpoint.
model AdminUser {
  id           String      @id @db.Uuid
  /// Lowercased (CHECK).
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         AdminRole
  status       AdminStatus @default(active)
  createdAt    DateTime    @default(now()) @map("created_at")
  lastSignInAt DateTime?   @map("last_sign_in_at")

  auditEntries          AdminAuditLog[]
  reportsReviewed       Report[]               @relation("reviewer")
  reportsResolved       Report[]               @relation("resolver")
  leaderboardExclusions LeaderboardExclusion[]

  @@map("admin_users")
}

/// Who did what, when, and why (docs/09). Append-only: a trigger refuses UPDATE and DELETE.
model AdminAuditLog {
  id         String   @id @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  reason     String?
  details    Json     @default("{}")
  createdAt  DateTime @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

/// A7.2 Rate limits: hits per bucket (a limit's name and a hashed address, email, or user id) in
/// a fixed window. Old windows are pruned by a recurring job.
model RateLimitWindow {
  bucket      String
  windowStart DateTime @map("window_start")
  hits        Int

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_windows")
}
